    "Your iPhone can wake this Mac with a network packet when Wake for network access is on. Works best over Ethernet, or over Wi‑Fi while plugged in." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu iPhone puede activar este Mac con un paquete de red cuando «Activar para acceso a la red» está activado. Funciona mejor por Ethernet, o por Wi‑Fi con el Mac enchufado."
          }
        }
      }
    },
    "Your iPhone finds this Mac automatically when both are on the same network." : {
      "localizations" : {
        "es" : {
